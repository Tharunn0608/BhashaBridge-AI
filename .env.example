GNANI_API_KEY=vach_1ytE2CY5X2ERvwRjzTuuBcbli77C5EbDslkferqvCC58pUJ70uaOTdhtRFv29y6FOahl7gQ8dGLvUmb3pPL7oSMZvMe7nH4L_3479182199eab68f22f819872ded9ae7

# ---- Gnani optional tuning (defaults shown) ----
# GNANI_BASE_URL=https://api.vachana.ai
# GNANI_STT_MODEL=prisma-v2.5      # or prisma-v3.0
# GNANI_STT_FORMAT=transcribe      # verbatim | transcribe (numbers as digits)
# GNANI_TTS_MODEL=timbre-v2.5      # or timbre-v3.0
# GNANI_TTS_SPEED=1.0              # 0.85 - 1.15
# GNANI_VOICE_HI_IN=Nalini         # override the voice per language (see docs.gnani.ai voice catalog)

# ---- Reasoning model (optional) ----
# Any OpenAI-compatible /chat/completions server. If you self-host Gnani Evon
# (gnani/gnani-evon-v3.3 on Hugging Face) with vLLM or SGLang, point these at it.
# Leave blank to use the demo-FAQ fallback only.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# LLM_LABEL=Gnani Evon
# LLM_DISABLE_THINKING=true        # hides reasoning traces for Evon (faster voice replies)

# ---- App ----
# HOST=127.0.0.1
# PORT=5000
